# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database and collection for vector store documents
MONGODB_DATABASE=rag_db
MONGODB_COLLECTION=documents

# Vector search index name (must match Atlas index)
VECTOR_INDEX_NAME=vector_index

# Voyage AI (embeddings) — https://www.mongodb.com/docs/voyageai/
VOYAGE_API_KEY=
# voyage-4-lite: https://docs.langchain.com/oss/python/integrations/embeddings/voyageai
VOYAGE_EMBEDDING_MODEL=voyage-4-lite
VOYAGE_EMBEDDING_DIMENSIONS=1024

# OpenAI (LLM)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
